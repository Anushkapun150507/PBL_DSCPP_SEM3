{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UNIGO: Build server",
      "type": "process",
      "command": "g++",
      "args": ["-std=c++14", "-O2", "-Wall", "-o", "backend/unigo_server.exe", "backend/server.cpp", "-lws2_32"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "UNIGO: Run server",
      "type": "process",
      "command": "${workspaceFolder}/backend/unigo_server.exe",
      "args": ["8080", "frontend", "data"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "UNIGO: Build server",
      "problemMatcher": []
    }
  ]
}
